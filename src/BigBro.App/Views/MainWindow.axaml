<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:BigBro.App.Views"
        xmlns:sys="using:System"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="BigBro.App.Views.MainWindow"
        Title="Overlook"
        Width="1360" Height="800" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen">


    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="7*,3*">

            <!-- Theme list -->
            <Border Grid.Column="0" Classes="sidebar">
            <DockPanel Margin="16,16,12,10" LastChildFill="True">
                <TextBlock x:Name="ThemesHeading" DockPanel.Dock="Top" Classes="heading" Text="Themes" Margin="0,0,0,8" />
                <TextBox DockPanel.Dock="Top" x:Name="SearchBox" PlaceholderText="Search name, size or tag" Margin="0,0,0,8" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                    <Button x:Name="EditorButton" HorizontalAlignment="Stretch" Margin="0,0,3,0" Content="Theme editor..." />
                    <Button x:Name="OpenFolderButton" HorizontalAlignment="Stretch" Margin="3,0" Content="Open themes folder" />
                    <Button x:Name="SettingsButton" HorizontalAlignment="Stretch" Margin="3,0,0,0" Content="Settings..." />
                </UniformGrid>
                <ListBox x:Name="ThemeList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <sys:Double x:Key="CardWidth">200</sys:Double>
                        <sys:Double x:Key="PreviewHeight">100</sys:Double>
                    </ListBox.Resources>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="4" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:ThemeItem">
                            <StackPanel Width="{DynamicResource CardWidth}" Spacing="6">
                                <Border Height="{DynamicResource PreviewHeight}" CornerRadius="4" ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" Classes="hint" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Border>

            <!-- Selected theme -->
            <DockPanel Grid.Column="1" Margin="8,16,16,8">
                <ScrollViewer>
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="NoThemeText" Classes="hint"
                                       Text="Pick a theme on the left. To bring your 1.x themes over, open the theme editor and use Import." />
                            <StackPanel x:Name="ThemeDetails" Spacing="10" IsVisible="False">
                                <Border CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Image x:Name="PreviewImage" MaxHeight="220" MaxWidth="640" Stretch="Uniform" />
                                </Border>
                                <TextBlock x:Name="ThemeTitle" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="ThemeInfo" Classes="hint" />
                                <Expander x:Name="CustomizeExpander" Header="Customize this theme" IsVisible="False" HorizontalAlignment="Stretch">
                                    <StackPanel x:Name="CustomizePanel" Spacing="8" Margin="0,8,0,0" />
                                </Expander>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ShowButton" Classes="accent" Content="Show panel" />
                                    <Button x:Name="HideButton" Content="Hide panel" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock x:Name="TestResult" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Border Grid.Row="1" Classes="statusbar" Padding="16,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="UpdateButton" Classes="accent" Padding="10,2" FontSize="12" IsVisible="False" />
                <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
